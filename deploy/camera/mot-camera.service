[Unit]
Description=MOT RTSP camera viewer
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mot
Group=mot
WorkingDirectory=/opt/mot/current
Environment=PYTHONUNBUFFERED=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=YOLO_CONFIG_DIR=/var/lib/mot-camera/ultralytics
Environment=MPLCONFIGDIR=/var/lib/mot-camera/matplotlib
EnvironmentFile=-/etc/mot/camera.env
LoadCredential=rtsp-url:/etc/mot/rtsp-url
ExecStart=/opt/mot/current/.venv/bin/python scripts/web_tools/serve_camera.py --rtsp-url-file %d/rtsp-url
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
StateDirectory=mot-camera
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
